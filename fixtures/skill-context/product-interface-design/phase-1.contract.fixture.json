        "id": "design-context.design-signal.calm-operational-density",
        "kind": "signal",
        "typeId": "design-context.design-signal",
        "title": "Calm Operational Density",
        "purpose": "Support dense expert work through alignment and progressive detail.",
        "applicability": {
          "selectors": {
            "domain": [
              "developer-platforms"
            ],
            "experience": [
              "application-workbench"
            ],
            "platform": [
              "web"
            ]
          },
          "positiveSignals": [
            "The interface exposes many comparable facts during repeated expert work."
          ],
          "negativeSignals": [
            "The audience needs stepwise explanation rather than dense comparison."
          ]
        },
        "problem": "Large card grids can make dense work busier without improving scanning.",
        "guidance": "Prefer quiet layers, aligned facts, and progressive detail when project evidence supports density.",
        "failureModes": [
          "Treating dark palettes or compact spacing as proof of professional quality."
        ],
        "constraints": {
          "accessibility": [
            "Maintain readable type, focus visibility, and sufficient contrast."
          ],
          "trust": [
            "Do not hide state or consequence to make a surface visually quiet."
          ],
          "responsive": [
            "Reduce simultaneous regions before reducing legibility."
          ],
          "originality": [
            "Do not reproduce a named product's dark shell or layout."
          ]
        },
        "sourceNoteIds": [
          "design-context.source-note.project-authority"
        ],
        "facets": {
