      {
        "id": "design-context.domain-guide.financial-high-trust",
        "kind": "guide",
        "typeId": "design-context.domain-guide",
        "title": "Financial And High-Trust Products",
        "purpose": "Make consequential decisions calm, explicit, and reviewable.",
        "applicability": {
          "selectors": {
            "domain": [
              "financial-high-trust"
            ],
            "platform": [
              "web",
              "mobile"
            ],
            "audience": [
              "account-holders",
              "financial-operators"
            ]
          },
          "positiveSignals": [
            "The Task presents money, authorization, compliance, or another consequential decision."
          ],
          "negativeSignals": [
            "The surface is decorative or carries no consequential state."
          ]
        },
        "problem": "Visual novelty can obscure amount, party, timing, permission, or reversibility.",
        "guidance": "Prioritize consequence visibility, review, confidence, and auditability over ornament.",
        "failureModes": [
          "Using dramatic motion or weak contrast around irreversible actions."
        ],
        "constraints": {
          "accessibility": [
            "Do not use color alone for financial state or risk."
          ],
          "trust": [
            "State amount, actor, destination, timing, and recovery before confirmation."
          ],
          "responsive": [
            "Keep review facts adjacent to confirmation on narrow screens."
          ],
          "originality": [
            "Do not borrow financial brands, copy, illustrations, or branded components."
          ]
        },
        "sourceNoteIds": [
          "design-context.source-note.normative-authority"
        ],
        "facets": {},
        "freshness": {
          "state": "active",
          "createdAt": "2026-08-09",
          "reviewedAt": "2026-08-09",
          "reviewAfter": "2027-02-05"
        },
        "contentDigest": "sha256:d2e666a380bba2ca7335c84c6599bbc52c27e038fe489b072136671bcb0e3e13"
      },
      {
        "id": "design-context.experience-guide.application-workbench",
        "kind": "guide",
        "typeId": "design-context.experience-guide",
        "title": "Application Workbench",
        "purpose": "Orient repeated work around one primary object and next decision.",
        "applicability": {
          "selectors": {
            "experience": [
              "application-workbench"
            ],
            "platform": [
              "web"
            ],
            "audience": [
              "operators",
              "experts"
            ]
          },
          "positiveSignals": [
            "The Task changes a multi-region workspace used for repeated operational work."
          ],
          "negativeSignals": [
            "The Task is a short linear setup flow or a public page."
          ]
        },
        "problem": "Equal-weight panels make the work object compete with navigation and metadata.",
        "guidance": "Anchor the workspace on one primary object, stable orientation, and progressive supporting detail.",
        "failureModes": [
          "Carding every region and giving all content equal emphasis."
        ],
        "constraints": {
          "accessibility": [
            "Keep landmarks, focus order, and pane labels stable as layout transforms."
          ],
          "trust": [
            "Preserve visible status and unsaved-work state across navigation."
          ],
          "responsive": [
            "Assign one scroll owner and move secondary panes behind named controls."
          ],
          "originality": [
            "Adapt the principle to project navigation and components rather than copying a workbench shell."
          ]
        },
        "sourceNoteIds": [
          "design-context.source-note.project-authority"
        ],
        "facets": {},
        "freshness": {
          "state": "active",
          "createdAt": "2026-08-09",
          "reviewedAt": "2026-08-09",
          "reviewAfter": "2027-02-05"
        },
        "contentDigest": "sha256:214f24988a7ef92af9b7147ad21b4082472874097efffcf44b3fd83dd87870b6"
      },
