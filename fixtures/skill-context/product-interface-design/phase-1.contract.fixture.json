        "id": "design-context.domain-guide.developer-platforms",
        "kind": "guide",
        "typeId": "design-context.domain-guide",
        "title": "Developer Platforms",
        "purpose": "Support legible density and efficient technical work.",
        "applicability": {
          "selectors": {
            "domain": [
              "developer-platforms"
            ],
            "platform": [
              "web"
            ],
            "audience": [
              "developers",
              "technical-operators"
            ]
          },
          "positiveSignals": [
            "The Task changes a repeated technical workflow on a rendered product surface."
          ],
          "negativeSignals": [
            "The Task is backend-only, generated-only, or a public marketing page."
          ]
        },
        "problem": "Generic dashboard composition can hide the primary technical object.",
        "guidance": "Keep the primary object direct, make density legible, and disclose detail progressively.",
        "failureModes": [
          "Copying a recognizable developer-tool shell instead of following project structure."
        ],
        "constraints": {
          "accessibility": [
            "Preserve semantic order and keyboard access at high density."
          ],
          "trust": [
            "Show scope and consequence before destructive actions."
          ],
          "responsive": [
            "Move secondary inspectors into named overlays rather than shrinking every pane."
          ],
          "originality": [
            "Do not copy another product's shell, palette, navigation, or wording."
          ]
        },
        "operationalCost": "May require pane-state and overflow testing.",
        "sourceNoteIds": [
          "design-context.source-note.project-authority"
        ],
        "facets": {},
        "freshness": {
