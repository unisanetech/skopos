{
  "extends": "../../typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "../..",
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "paths": {
      "@skopos/config": [
        "../config/src/index.ts"
      ],
      "@skopos/model": [
        "../model/src/index.ts"
      ],
      "@skopos/query": [
        "../query/src/index.ts"
      ],
      "@skopos/*": [
        "../*/src"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
