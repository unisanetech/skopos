{
  "name": "@skopos/config",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Root config contracts and config helpers for the Skopos SDK",
  "skopos": {
    "surface": "public-sdk-core",
    "releaseTarget": "candidate",
    "publishPhase": "incubation"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@skopos/model": "workspace:*",
    "yaml": "^2.8.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.2"
  }
}
