{
  "name": "@skopos/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Application runtime orchestration for the Skopos SDK",
  "skopos": {
    "surface": "public-sdk-core",
    "releaseTarget": "candidate",
    "publishPhase": "incubation"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "check-types": "tsc --noEmit"
  },
  "dependencies": {
    "@skopos/config": "workspace:*",
    "@skopos/docs-engine": "workspace:*",
    "@skopos/indexer": "workspace:*",
    "@skopos/instructions": "workspace:*",
    "@skopos/model": "workspace:*",
    "@skopos/planner": "workspace:*",
    "@skopos/query": "workspace:*",
    "@skopos/verification": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.2"
  }
}
