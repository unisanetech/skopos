{
  "name": "@skopos/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI entrypoint for the Skopos SDK",
  "skopos": {
    "surface": "tool-surface",
    "releaseTarget": "candidate",
    "publishPhase": "incubation"
  },
  "bin": {
    "skopos": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/cli.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/cli.ts --format esm --dts --watch",
    "check-types": "tsc --noEmit",
    "test": "vitest run src/__tests__/package-boundaries.test.ts src/__tests__/release-surface.test.ts src/__tests__/compact-output.test.ts src/__tests__/cli.e2e.test.ts",
    "proof": "vitest run src/__tests__/proof-phase.e2e.test.ts"
  },
  "dependencies": {
    "@skopos/model": "workspace:*",
    "@skopos/runtime": "workspace:*",
    "@skopos/ui": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.9.2",
    "vitest": "^4.0.17"
  }
}
