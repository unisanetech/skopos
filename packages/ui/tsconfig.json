{
  "extends": "../../typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": "../..",
    "paths": {
      "@skopos/*": [
        "./packages/*/src"
      ]
    },
    "module": "ESNext",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "src/**/*",
    "vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "src/**/__tests__/**",
    "src/**/*.test.ts",
    "src/**/*.spec.ts"
  ]
}
